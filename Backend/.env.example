# ─── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/plateforme?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────
ECOM_JWT_SECRET=your_jwt_secret_here

# ─── Google OAuth ──────────────────────────────────────────
# Optional: comma-separated list. Useful when prod/staging/local use different web client IDs.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ─── Cloudflare R2 (file storage) ─────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional production CDN/custom domain for R2 public assets.
# Must point to the R2 bucket custom domain before enabling.
R2_CDN_URL=

# ─── Cloudflare Images (product photos) ────────────────────
# Get from: https://dash.cloudflare.com → Images → API Tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ─── Web Push (VAPID keys) ────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# IMPORTANT: Keys must be in Base64URL format (A-Z, a-z, 0-9, -, _)
# NO padding (=), NO + or / characters
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# ─── WhatsApp Green API ───────────────────────────────────
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# ─── Email SMTP (Postfix Scalor — canal MARKETING) ────────
# Les campagnes marketing (source campaign / campaign_test) passent TOUJOURS
# par ce SMTP auto-hébergé, quel que soit EMAIL_PROVIDER.
SMTP_HOST=mail.scalor.net
SMTP_PORT=587
SMTP_USER=smtpuser
SMTP_PASS=
SMTP_MIN_SEND_GAP_MS=3000
EMAIL_FROM=noreply@scalor.net
EMAIL_FROM_NAME=Scalor
EMAIL_REPLY_TO=support@scalor.net
ADMIN_EMAIL=support@scalor.net

# ─── Emails transactionnels via Resend ────────────────────
# EMAIL_PROVIDER=resend : tous les emails HORS marketing (otp, notifications,
# contact, custom, app) partent via l'API Resend (cf. core/notifications/mailer.js).
# Le domaine de EMAIL_FROM doit d'abord être vérifié chez Resend
# (https://resend.com/domains). Si la clé est absente, fallback SMTP.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Écart min entre 2 appels API Resend (ms) — limite Resend ~2 req/s
RESEND_MIN_SEND_GAP_MS=600

# ─── OTP transactionnels (canal dédié otpMailer.js) ───────
# Le domaine de OTP_EMAIL_FROM doit d'abord être vérifié chez Resend.
OTP_EMAIL_PROVIDER=resend
OTP_EMAIL_FROM="Scalor <noreply@scalor.net>"
OTP_REPLY_TO=support@scalor.net

# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Cascade texte : DeepSeek (primaire) → Groq → KIE ─────
# TOUTE la generation de texte et de code passe par cette cascade
# (services/textProviderService.js). On ne bascule sur le provider
# suivant que sur erreur TRANSITOIRE : timeout, 429, 5xx, reseau,
# reponse vide. Une 400 (requete malformee) est remontee directement.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=300000
# 'enabled' pour laisser DeepSeek raisonner (risque de reponse vide).
DEEPSEEK_THINKING=disabled
# Secours 1 — Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Force la tete de cascade sans redeploiement : deepseek | groq | kie
AI_TEXT_PRIMARY=deepseek
# Urgence : bascule aussi sur les erreurs deterministes (400/413/422).
AI_FALLBACK_ON_ALL_ERRORS=false

# ─── KIE API — dernier recours texte, obligatoire pour la vision ──
# Plus jamais primaire sur le texte. Reste le SEUL chemin pour :
#   - les messages contenant une image (DeepSeek et Groq ne lisent pas d'images)
#   - le function calling au format Responses (`tools`)
# Egalement utilise hors texte : images (gpt-image-2, nano-banana) et video (Veo).
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_GEMINI_MODEL=gemini-2.5-flash
KIE_REASONING_EFFORT=low
KIE_TIMEOUT_MS=120000

# ─── Ticket dispatch → Claude Code via GitHub Actions ────
# GitHub token with repo + workflow/dispatch permissions.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=koumen222/ecomcookpit
PUBLIC_BACKEND_URL=https://api.scalor.net
# Must match the GitHub Actions secret TICKET_CALLBACK_SECRET.
TICKET_CALLBACK_SECRET=
TICKET_PR_BASE=dev

# ─── Shopify ───────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=https://api.scalor.net/api/ecom/shopify/callback
# Webhook secret (from Shopify → Settings → Notifications → Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# ─── Scrape.do (Alibaba scraping) ──────────────────────────
# Get from: https://scrape.do/
SCRAPE_DO_TOKEN=

# ─── Google Gemini (Nano Banana 2) — fallback génération images ─────────
# Utilisé comme filet de secours quand Kie.ai (NANOBANANA_PRO_API_KEY) échoue
# sur la génération de visuels de page produit (poster, infographics).
# Modèle : gemini-3-pro-image-preview (Nano Banana Pro).
# Alternatives : gemini-3.1-flash-image-preview (Nano Banana 2), gemini-2.5-flash-image (v1).
# Get from: https://aistudio.google.com/app/apikey
# IMPORTANT: ne JAMAIS commiter la vraie clé — laisser vide ici et la définir
# dans les variables d'env Railway/Vercel.
GEMINI_API_KEY=
# Alias historique conservé pour rétro-compatibilité (geminiProductExtractor.js)
# Si GEMINI_API_KEY est défini, il a la priorité.
NANOBANANA_API_KEY=
# (Optionnel) override du modèle Gemini image
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ─── Groq API (LLM pour génération contenu) ────────────────
GROQ_API_KEY=

# ─── Server ───────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ─── Marketing plateforme (super admin → utilisateurs Scalor) ────────────────
# Sous-domaine DÉDIÉ, vérifié chez Resend. Séparer ce trafic de scalor.net
# protège la délivrabilité des OTP et des reçus : une campagne mal reçue ne
# doit pas empêcher quelqu'un de recevoir son code de connexion.
# Laisser VIDE tant qu'un sous-domaine dédié n'est pas vérifié chez Resend :
# l'expéditeur retombe alors sur le domaine de EMAIL_FROM (déjà vérifié, il
# porte les OTP) avec l'adresse locale MARKETING_EMAIL_LOCALPART.
# Un domaine non vérifié fait échouer 100 % des envois.
MARKETING_EMAIL_FROM=""
MARKETING_EMAIL_LOCALPART="news"
MARKETING_EMAIL_FROM_NAME="Scalor"
# Une vraie boîte lue — un reply-to mort est un signal négatif de plus.
MARKETING_EMAIL_REPLY_TO="support@scalor.net"
# Identité postale affichée en pied d'email (exigée par CAN-SPAM, attendue par
# les filtres). Vide, le pied de page l'omet.
MARKETING_SENDER_IDENTITY="Scalor"
MARKETING_SENDER_ADDRESS=""
# Sélecteurs DKIM sondés par l'audit de délivrabilité, du plus probable au moins.
MARKETING_DKIM_SELECTORS="resend,mail,default,s1,k1,scalor"
